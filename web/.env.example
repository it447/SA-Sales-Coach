# Postgres connection string. Default: Vercel Postgres (Storage tab -> Create
# Database -> Postgres) — it auto-injects POSTGRES_URL for you when the
# database is connected to this project; `vercel env pull .env.local` grabs
# it locally. Supabase also works (paste its connection string into
# DATABASE_URL instead) since lib/db.ts just needs a standard Postgres URL.
POSTGRES_URL=
DATABASE_URL=

# Anthropic (Claude) API key, used for scope extraction, objection suggestions, and JD generation.
ANTHROPIC_API_KEY=

# Shared secret the Chrome extension sends as `Authorization: Bearer <key>` on every request.
# Simple internal-only auth — swap for Google Workspace SSO later if needed.
INTERNAL_API_KEY=
