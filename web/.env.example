# Postgres connection string (Vercel Postgres or Supabase both work — either name is read).
POSTGRES_URL=
DATABASE_URL=

# Anthropic (Claude) API key, used for scope extraction, objection suggestions, and JD generation.
ANTHROPIC_API_KEY=

# Stripe secret key + webhook signing secret (Payment Links + webhook verification).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared secret the Chrome extension sends as `Authorization: Bearer <key>` on every request.
# Simple internal-only auth — swap for Google Workspace SSO later if needed.
INTERNAL_API_KEY=
