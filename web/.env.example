# Postgres connection string. Default: Vercel Postgres (Storage tab -> Create
# Database -> Postgres) — it auto-injects POSTGRES_URL for you when the
# database is connected to this project; `vercel env pull .env.local` grabs
# it locally. Supabase also works (paste its connection string into
# DATABASE_URL instead) since lib/db.ts just needs a standard Postgres URL.
POSTGRES_URL=
DATABASE_URL=

# Anthropic (Claude) API key, used for scope extraction, objection suggestions, and JD generation.
ANTHROPIC_API_KEY=

# Shared secret the Chrome extension sends as `Authorization: Bearer <key>` on every request.
# Simple internal-only auth for the extension's API calls.
INTERNAL_API_KEY=

# Human login for the /dashboard pages (Phase 4) — Google Sign-In restricted to
# @scalearmy.com accounts. Create an OAuth client in Google Cloud Console
# (APIs & Services -> Credentials -> Create Credentials -> OAuth client ID,
# type "Web application") with an authorized redirect URI of
# <your deployed URL>/api/auth/callback/google (and http://localhost:3000/api/auth/callback/google for local dev).
#
# This same client is also reused for per-rep Google Meet recording control
# (Phase 2 of the Fathom-replacement work, see lib/googleMeetAuth.ts) --
# add a SECOND authorized redirect URI on the same OAuth client:
# <your deployed URL>/api/google/callback (and the localhost equivalent for
# local dev). Also enable the "Google Meet API" for this project in Google
# Cloud Console (APIs & Services -> Library -> search "Google Meet API" ->
# Enable) -- the meetings.space.settings scope it needs is non-sensitive, so
# no Google app-verification process is required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret NextAuth uses to sign session tokens. Generate with:
# openssl rand -base64 32
NEXTAUTH_SECRET=

# The canonical URL this app is deployed at (NextAuth needs this to build
# correct callback URLs) — set explicitly, e.g. https://sa-sales-coach.vercel.app
# in production or http://localhost:3000 for local dev. Not auto-detected.
NEXTAUTH_URL=
